# Non-secret deploy config — safe to commit.
# The real secrets (DB password, JWT secret) are NOT here. Jenkins injects
# them at build time from Jenkins Credentials, as environment variables —
# Docker Compose lets a shell environment variable override the same key
# from this file, so the secrets never touch git.
# See Jenkinsfile for the credential IDs it expects.

# Host ports (chosen to avoid clashing with existing containers on the server:
# homedecor uses 9090, maison-frontend uses 3000, zeezaglobal uses 3002)
BACKEND_PORT=8081
FRONTEND_PORT=3001

# Backend / database
SPRING_DATASOURCE_URL=jdbc:mysql://147.93.43.194:3306/gymmanagement
SPRING_DATASOURCE_USERNAME=athul
# SPRING_DATASOURCE_PASSWORD — injected by Jenkins (credential id: gymmanagement-db-password)

# Backend / auth
# APP_JWT_SECRET — injected by Jenkins (credential id: gymmanagement-jwt-secret)
APP_JWT_EXPIRATION_MS=86400000
APP_GOOGLE_CLIENT_ID=798189244460-5soaopacnhgfaf7hj4nelo4s8fmihn6b.apps.googleusercontent.com

# Backend / CORS — must include the public URL the frontend is served from
APP_CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:3001

# Frontend build args — public URL the browser will call the backend on
# (baked into the JS bundle at build time, so this must be reachable from
# the visitor's browser, not a Docker-internal hostname)
NEXT_PUBLIC_API_BASE_URL=http://YOUR_SERVER_IP:8081
